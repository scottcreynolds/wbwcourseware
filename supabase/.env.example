# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY
# when functions run. Do not copy those runtime values into this file.
# Bootstrap authorization secret (also configure in Supabase Function secrets for production).
BOOTSTRAP_TEACHER_SECRET=replace-with-a-long-random-secret
# Operator-only values consumed by pnpm bootstrap:teacher.
BOOTSTRAP_TEACHER_EMAIL=teacher@example.com
BOOTSTRAP_TEACHER_DISPLAY_NAME=Teacher Name
# Browser origin used for CORS and invitation/password links.
APP_ORIGIN=http://127.0.0.1:5173
# Optional override used by pnpm bootstrap:teacher when choosing local.
LOCAL_FUNCTION_URL=http://127.0.0.1:55321/functions/v1/bootstrap-teacher
# Used by pnpm bootstrap:teacher only when choosing production.
SUPABASE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/bootstrap-teacher
# `local` returns links to Mailpit; `production` sends through Resend.
APP_ENV=local
# Production-only Resend settings; leave the key empty locally.
RESEND_API_KEY=
EMAIL_FROM=Writers Be Writing <classes@example.com>
# Teacher email notifications (new discussion topics, submissions) are
# dispatched by a database trigger via pg_net. Run `pnpm provision:notify-vault`
# once per environment to seed the two Vault secrets that trigger reads --
# see "One-time Vault secret setup" in docs/EMAIL.md.
# Local values consumed by pnpm provision:notify-vault (production values are
# never stored in a file -- pass PRODUCTION_SERVICE_ROLE_KEY as an env var at
# invocation time instead, e.g. `PRODUCTION_SERVICE_ROLE_KEY=... SUPABASE_REST_URL=... SUPABASE_NOTIFY_TEACHER_FUNCTION_URL=... pnpm provision:notify-vault`).
LOCAL_REST_URL=http://127.0.0.1:55321/rest/v1
LOCAL_NOTIFY_TEACHER_FUNCTION_URL=http://kong:8000/functions/v1/notify-teacher
